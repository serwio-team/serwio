# Skopiuj ten plik do .env w głównym folderze projektu.
# Po zmianie ustawień uruchom backend ponownie.

# Hasło użytkownika serwio w PostgreSQL. Ustaw własne przed pierwszym startem bazy.
# Zmiana tej wartości nie zmienia hasła w już utworzonym wolumenie PostgreSQL.
# Przy TEMP_DB=true ta wartość nie jest używana.
DB_PASSWORD=change-me-before-first-start

# Port PostgreSQL na Twoim komputerze, np. localhost:5433.
# Kontener nadal używa portu 5432. Przy TEMP_DB=true ustawienie jest pomijane.
DB_PORT=5433

# true: przy starcie przygotuj brakujące konta testowe: właściciela z lokalizacją oraz firmę
# serwisową z oddziałem i serwisantem. locationId i branchId pojawią się w logach.
# Istniejące wpisy nie są nadpisywane.
# false: nie przygotowuj danych startowych; istniejące dane pozostają w bazie.
SEED_DATA=true

# Hasło kont testowych owner@example.com, company@example.com i technician@example.com
# do logowania na /login.
# Ustawiane przy tworzeniu konta; zmiana wartości nie resetuje istniejącego hasła.
# Pusta wartość: wygeneruj osobne hasło dla każdego konta i wypisz je w logach.
# Przy TEMP_DB=true konto i hasło są tworzone od nowa po restarcie backendu.
SEED_PASSWORD=change-me-before-first-login

# true: tymczasowa baza H2 w pamięci, bez uruchamiania Docker Compose.
# Dane znikają po zamknięciu lub restarcie backendu; seeder nadaje nowe locationId.
# false: trwała baza PostgreSQL w Dockerze, korzystająca z DB_PASSWORD i DB_PORT.
TEMP_DB=false
